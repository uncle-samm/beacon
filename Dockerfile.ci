# Beacon CI image for unit, lint, and browser/CDP shard jobs.
#
# The browser harness needs Gleam/Erlang, Node/npm for esbuild, Python for CDP,
# and Chromium. Keep this image test-focused; the production Dockerfile remains
# separate.
FROM ghcr.io/gleam-lang/gleam:v1.14.0-erlang

WORKDIR /app

USER root

RUN if command -v apt-get >/dev/null 2>&1; then \
      apt-get update && \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        chromium \
        nodejs \
        npm \
        python3 \
        python3-pip \
        python3-venv \
        procps \
        lsof && \
      rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
      apk add --no-cache \
        ca-certificates \
        chromium \
        lsof \
        nodejs \
        npm \
        procps \
        py3-pip \
        py3-virtualenv \
        python3; \
    else \
      echo "Unsupported base image package manager" >&2; \
      exit 1; \
    fi

COPY requirements-dev.txt ./
RUN python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt

COPY . .

ENV CHROME_BIN=/usr/bin/chromium
ENV CHROME_EXTRA_ARGS="--no-sandbox --disable-dev-shm-usage"
ENV PYTHON_BIN=/app/.venv/bin/python

RUN set -eu; \
    gleam deps download; \
    for gleam_toml in examples/*/gleam.toml; do \
      example_dir="$(dirname "$gleam_toml")"; \
      (cd "$example_dir" && gleam deps download); \
    done

ARG BEACON_CDP_PREBUILD_EXAMPLES=0

RUN set -eu; \
    if [ "$BEACON_CDP_PREBUILD_EXAMPLES" = "1" ]; then \
      gleam build; \
      for gleam_toml in examples/*/gleam.toml; do \
        example_dir="$(dirname "$gleam_toml")"; \
        (cd "$example_dir" && gleam build); \
      done; \
    elif [ "$BEACON_CDP_PREBUILD_EXAMPLES" != "0" ]; then \
      echo "BEACON_CDP_PREBUILD_EXAMPLES must be 0 or 1" >&2; \
      exit 1; \
    fi

CMD ["sh", "-lc", "gleam build && gleam test && gleam run -m beacon/lint"]
